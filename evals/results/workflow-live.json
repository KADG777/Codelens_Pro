      "initial_code": "def summarize_orders(orders):\n    \"\"\"Summarize a list of orders.\n\n    Each order must be a mapping with an integer ``amount_cents`` (non-negative,\n    bool not accepted) and a boolean ``paid``. Returns a dict with\n    ``paid_count`` and ``total_cents`` counting only paid orders. The input is\n    not modified.\n    \"\"\"\n    paid_count = 0\n    total_cents = 0\n\n    for order in orders:\n        if not isinstance(order, dict):\n            raise ValueError(\"each order must be a mapping\")\n        if \"amount_cents\" not in order:\n            raise ValueError(\"missing field: amount_cents\")\n        if \"paid\" not in order:\n            raise ValueError(\"missing field: paid\")\n\n        amount = order[\"amount_cents\"]\n        paid = order[\"paid\"]\n\n        if isinstance(amount, bool) or not isinstance(amount, int):\n            raise ValueError(\"amount_cents must be a non-negative integer\")\n        if amount < 0:\n            raise ValueError(\"amount_cents must be a non-negative integer\")\n        if not isinstance(paid, bool):\n            raise ValueError(\"paid must be a boolean\")\n\n        if paid:\n            paid_count += 1\n            total_cents += amount\n\n    return {\"paid_count\": paid_count, \"total_cents\": total_cents}\n",
      "final_code": "def summarize_orders(orders):\n    \"\"\"Summarize a list of orders.\n\n    Each order must be a mapping with an integer ``amount_cents`` (non-negative,\n    bool not accepted) and a boolean ``paid``. Returns a dict with\n    ``paid_count`` and ``total_cents`` counting only paid orders. The input is\n    not modified.\n    \"\"\"\n    paid_count = 0\n    total_cents = 0\n\n    for order in orders:\n        if not isinstance(order, dict):\n            raise ValueError(\"each order must be a mapping\")\n        if \"amount_cents\" not in order:\n            raise ValueError(\"missing field: amount_cents\")\n        if \"paid\" not in order:\n            raise ValueError(\"missing field: paid\")\n\n        amount = order[\"amount_cents\"]\n        paid = order[\"paid\"]\n\n        if isinstance(amount, bool) or not isinstance(amount, int):\n            raise ValueError(\"amount_cents must be a non-negative integer\")\n        if amount < 0:\n            raise ValueError(\"amount_cents must be a non-negative integer\")\n        if not isinstance(paid, bool):\n            raise ValueError(\"paid must be a boolean\")\n\n        if paid:\n            paid_count += 1\n            total_cents += amount\n\n    return {\"paid_count\": paid_count, \"total_cents\": total_cents}\n",
