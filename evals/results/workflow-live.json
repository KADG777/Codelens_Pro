      "initial_code": "def text_stats(text):\n    \"\"\"Return character, word, and line counts for *text*.\n\n    characters: total number of characters, including whitespace.\n    words: number of non-whitespace tokens as produced by str.split().\n    lines: number of lines as produced by str.splitlines().\n\n    For an empty string all three counts are 0.\n    \"\"\"\n    if not text:\n        return {\"characters\": 0, \"words\": 0, \"lines\": 0}\n    return {\n        \"characters\": len(text),\n        \"words\": len(text.split()),\n        \"lines\": len(text.splitlines()),\n    }\n",
      "final_code": "def text_stats(text):\n    \"\"\"Return character, word, and line counts for *text*.\n\n    characters: total number of characters, including whitespace.\n    words: number of non-whitespace tokens as produced by str.split().\n    lines: number of lines as produced by str.splitlines().\n\n    For an empty string all three counts are 0.\n    \"\"\"\n    if not text:\n        return {\"characters\": 0, \"words\": 0, \"lines\": 0}\n    return {\n        \"characters\": len(text),\n        \"words\": len(text.split()),\n        \"lines\": len(text.splitlines()),\n    }\n",
