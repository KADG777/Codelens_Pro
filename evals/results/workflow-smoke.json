      "initial_code": "def summarize_orders(orders):\n    paid_count = 0\n    total_cents = 0\n    for order in orders:\n        if order['paid']:\n            paid_count += 1\n            total_cents += amount_cents\n    return {'paid_count': paid_count, 'total_cents': total_cents}\n",
      "final_code": "def summarize_orders(orders):\n    paid_count = 0\n    total_cents = 0\n    for order in orders:\n        if not isinstance(order, dict):\n            raise ValueError(\"订单必须是字典\")\n        if \"amount_cents\" not in order or \"paid\" not in order:\n            raise ValueError(\"订单缺少字段\")\n        amount = order[\"amount_cents\"]\n        paid = order[\"paid\"]\n        if type(amount) is not int or amount < 0 or type(paid) is not bool:\n            raise ValueError(\"订单字段非法\")\n        if paid:\n            paid_count += 1\n            total_cents += amount\n    return {\"paid_count\": paid_count, \"total_cents\": total_cents}\n",
